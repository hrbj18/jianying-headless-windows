  "rules": [
    {
      "id": "R01",
      "name": "单次相遇形成微故事",
      "trigger": "同一组路人/同一事件有可理解的问答或动作结果",
      "instruction": "以一句问题或反应进入，保留必要身份和答复，再交代笑点、惊喜或温暖结果；删掉等候与无关串场，不拼接改变原意",
      "examples": [
        "E02",
        "E08",
        "E12"
      ],
      "confidence": "high",
      "exceptions": "表演和展会短梗可以较少口语，不强行补访谈"
    },
    {
      "id": "R02",
      "name": "有包袱才做真实冷开场",
      "trigger": "稍后有无需额外解释也能吸引人的原声金句/反应",
      "instruction": "用1～3秒原片高光作预告，硬切回最短理解语境，保留后面的铺垫与回应；不要让预告误导因果",
      "examples": [
        "E03",
        "E04",
        "E05",
        "E06",
        "E15"
      ],
      "confidence": "high",
      "exceptions": "英语问候、老人祝福等可直接入场，不强行制造冲突"
    },
    {
      "id": "R03",
      "name": "竖屏关系构图优先",
      "trigger": "人和机器狗共同完成互动",
      "instruction": "保留真人脸部、机器狗动作和双方空间关系；默认原比例，只有不裁掉任一方才轻微推近",
      "examples": [
        "E01",
        "E02",
        "E08",
        "E13"
      ],
      "confidence": "high",
      "exceptions": "不把全身互动一律裁成狗头特写"
    },
    {
      "id": "R04",
      "name": "可读的短句原声字幕",
      "trigger": "可辨识原声问答",
      "instruction": "常规对话采用粗体橙黄字、暗描边，位于画面约77～80%高，按真实词时钟分成约8～12字短句；核对粤仔/方言/数字，不把ASR错字直接烧入",
      "examples": [
        "E01",
        "E02",
        "E08",
        "E09"
      ],
      "confidence": "high",
      "exceptions": "演出/展会/温暖人物主题有白字粉描边或米白子类；颜色不是身份判定"
    },
    {
      "id": "R05",
      "name": "把视觉重音留给真实反应",
      "trigger": "画面确有笑容、惊讶、爱心或动作",
      "instruction": "包袱后保留约0.6～1.5秒真实反应，才加一次哈哈/问号/心动等普通大字；字幕叙事层和反应字分层，避免挡脸挡狗",
      "examples": [
        "E02",
        "E05",
        "E09",
        "E15"
      ],
      "confidence": "high",
      "exceptions": "环卫等温暖题材降低笑声大字密度；无反应画面不编造观众反应"
    },
    {
      "id": "R06",
      "name": "先完成情感动作再轻收尾",
      "trigger": "真实告别、祝福、合照、爱心或笑点已有结果",
      "instruction": "保留自然结束，必要时接约1～2秒品牌关注卡；不在祝福、握手、表演过程中截断",
      "examples": [
        "E16",
        "E17",
        "E18"
      ],
      "confidence": "high",
      "exceptions": "展会21秒短梗未见品牌片尾，CTA可选，片尾有多个视觉版本"
    },
    {
      "id": "R07",
      "name": "封面与视频正文分开处理",
      "trigger": "需要成片封面",
      "instruction": "单独制作封面，视频立即进入真实内容；若嵌入参考式首帧封面，仅保留约2帧，不做长静态开场",
      "examples": [
        "E19",
        "E20"
      ],
      "confidence": "medium",
      "exceptions": "0.1秒前的封面可能含平台封装习惯，因此不是必须继承的叙事规则"
    },
    {
      "id": "R08",
      "name": "按事件子类控制节奏",
      "trigger": "内容属于日常问答、温暖人物、现场表演或展会短梗",
      "instruction": "以事件完整性决定时长；问答保留自然来回，温暖人物减少喜剧贴字，表演保留连贯动作，短梗可以硬切；不为统一秒数或特效堆叠破坏故事",
      "examples": [
        "E10",
        "E11",
        "E12",
        "E13"
      ],
      "confidence": "high",
      "exceptions": "未听完整音轨，音乐曲目、混音音量及音乐版权均不作已验证规则"
    }
  ],
